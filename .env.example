# Copy to .env and set a unique salt before running anything that will see real
# traffic. Every stored digest depends on it; changing it later breaks
# correlation with previously captured events.
EDL_CREDENTIAL_SALT=change-me-to-something-unique

# Forward-confirmed reverse DNS for crawler verification.
EDL_VERIFY_BOT_RDNS=true

# Sliding window, in seconds, for velocity signals.
EDL_VELOCITY_WINDOW=300

# Set to false to store only the salted hash of source addresses.
EDL_STORE_IP_RAW=true

# Bind address for the public edge listener. Change only when you are
# deliberately exposing the sensor, on a host isolated from anything you care
# about.
EDL_PUBLIC_BIND=127.0.0.1
